    {
      "name": "a nested schema: items, anyOf, examples, a default and $defs",
      "tools": [
        {
          "name": "search",
          "description": "Search the notes.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "filters": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/Tag"
                    },
                    {
                      "type": "string",
                      "examples": [
                        "work"
                      ]
                    }
                  ]
                }
              },
              "limit": {
                "type": "integer",
                "default": 10
              },
              "mode": {
                "type": "string",
                "default": "fast",
                "title": "Mode"
              }
            },
            "$defs": {
              "Tag": {
                "type": "object",
                "title": "A tag",
                "properties": {
                  "label": {
                    "type": "string",
                    "description": "Its label."
                  }
                }
              }
            }
          }
        }
      ],
