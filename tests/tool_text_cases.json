          "name": "watch_models",
          "title": "Watch models",
          "description": "Check the providers' pages and report what changed.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "enum": [
                  "openai",
                  "google",
                  "xai",
                  "anthropic"
